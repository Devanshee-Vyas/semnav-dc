# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf
*.pyx text eol=lf

# Config files
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
LICENSE text eol=lf

# Binary files
*.pkl binary
*.npy binary
*.npz binary
*.pth binary
*.ckpt binary
*.pt binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mat binary

